{
  "name": "@ratmath/finance",
  "version": "0.1.0",
  "description": "The mathematics of finance for RatMath: exact money, time value, loans, bonds, scenarios and building blocks for simulating financial situations",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test ./tests",
    "docs:build": "bun scripts/build-docs.js"
  },
  "keywords": [
    "finance",
    "time-value-of-money",
    "loan",
    "amortization",
    "bond",
    "simulation",
    "exact",
    "ratmath"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/finance.git"
  },
  "homepage": "https://ratmath.com/finance/",
  "bugs": {
    "url": "https://github.com/ratmath/finance/issues"
  },
  "dependencies": {
    "@ratmath/core": "^0.10.0",
    "@ratmath/analytic": "^0.1.0",
    "@ratmath/algebraic": "^0.1.0"
  },
  "devDependencies": {
    "katex": "0.19.1"
  },
  "types": "index.d.ts",
  "author": "James Taylor",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "vendor/analytic",
    "vendor/algebraic"
  ]
}
