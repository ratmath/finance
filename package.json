{
  "name": "@ratmath/finance",
  "version": "0.2.0",
  "description": "The mathematics of finance for RatMath: exact money, time value, loans, bonds, scenarios, uncertain inputs and repeated runs, portfolios, options and life contingencies",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test ./tests",
    "docs:build": "bun scripts/build-docs.js && node scripts/build-llms.mjs",
    "docs:llms": "node scripts/build-llms.mjs"
  },
  "keywords": [
    "finance",
    "time-value-of-money",
    "loan",
    "amortization",
    "bond",
    "simulation",
    "exact",
    "ratmath",
    "monte-carlo",
    "portfolio",
    "option-pricing",
    "actuarial"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/finance.git"
  },
  "homepage": "https://ratmath.com/finance/",
  "bugs": {
    "url": "https://github.com/ratmath/finance/issues"
  },
  "dependencies": {
    "@ratmath/analytic": "^0.1.0",
    "@ratmath/algebraic": "^0.1.0",
    "@ratmath/stats": "^0.3.0",
    "@ratmath/discrete": "^0.3.0"
  },
  "peerDependencies": {
    "@ratmath/core": ">=0.10.0 <0.12.0"
  },
  "devDependencies": {
    "@ratmath/core": "^0.11.0",
    "katex": "0.19.1"
  },
  "types": "index.d.ts",
  "author": "James Taylor",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "vendor/analytic",
    "vendor/algebraic",
    "vendor/stats",
    "vendor/discrete",
    "vendor/logic"
  ]
}
